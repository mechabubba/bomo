<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="{{ iconType || "image/x-icon" }}" {{{ `href="${icon || "/favicon.ico"}"` }}} />
<title id="title">{{ title || "bomo" }}</title>
<meta property="og:title" content="{{ title || "bomo" }}" />
@if (description)
<meta name="description" content="{{ description }}" />
<meta property="og:description" content="{{ description }}" />
@end
@if (logo)
<meta property="og:image" content="{{ logo }}" />
@end
<meta name="author" content="https://github.com/mechabubba/bomo/graphs/contributors" />
<link rel="author" href="https://github.com/mechabubba/bomo/graphs/contributors" />
<link rel="stylesheet" href="/css/themes/dark.css" />
<link rel="stylesheet" href="/css/shared.css" />
<link rel="stylesheet" href="/css/standard.css" />